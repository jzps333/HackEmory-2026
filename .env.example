# Backend: uvicorn api.main:app --reload
FACTORY_DB=var/factory.sqlite3
# Explicit browser origins if directly accessing the Python API (UI proxy is same-origin).
FACTORY_ORIGINS=http://localhost:3000
# QR runner: no mock verdict is returned when these are absent.
SANDBOX_URL=
SANDBOX_TOKEN=
JEV_API_KEY=
GEMINI_API_KEY=
# Chert signed message events
CHERT_WEBHOOK_SECRET=
# Optional provider reply delivery; off until explicitly configured.
FACTORY_SEND_REPLIES=0
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
