# Copy to .env and fill in. Never commit .env.

# --- Jev (runs through OpenRouter: use your OpenRouter key) ---
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.14
# At or above this malicious score -> block. Between SECOND_LOOK and BLOCK -> Gemini takes a second look.
BLOCK_SCORE=0.8
SECOND_LOOK_SCORE=0.5

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Sandbox server (separate Vultr VM, no keys on it) ---
# Empty = /scan returns mock data so other parts can build now.
SANDBOX_URL=
SANDBOX_TOKEN=

# --- Chert (FaceTime + iMessage) ---
CHERT_API_KEY=
CHERT_WEBHOOK_SECRET=
# LiveKit values go in chert/<agent>/.env.local (written by `lk app env -w -d .env.local`)

# --- Typesense ---
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# --- Tiger Data (Postgres connection string from the downloaded .env) ---
TIGER_DATABASE_URL=

# --- Solana (devnet only) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=

# --- Chert agent extras (chert/agent_integration.py, chert/imessage.py) ---
SCANSAFE_API_URL=http://localhost:8000
CHERT_PROJECT_ID=
CHERT_LINE_ID=
SCANSAFE_DEMO_PHONE=
AGENT_NAME=scansafe-agent

# --- Saved accounts (api/routes_accounts.py, docs/UI_API.md section 9) ---
# Fernet key for linked-account tokens at rest:
#   python3 -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
ACCOUNT_KEY=
# Mixed into every phone hash. Empty = generated once into ~/.scansafe-account-pepper. Never change it later.
ACCOUNT_PEPPER=
# Shared with the FaceTime agent (header X-Agent-Key on POST /operators/dogwood/app-session):
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
AGENT_INTERNAL_KEY=
# Where link flows send the browser back: <APP_BASE_URL>/accounts?linked=... (empty = https://scansafe.nyc/?linked=...)
APP_BASE_URL=https://app.scansafe.nyc
# PayPal SANDBOX only (developer.paypal.com > Apps & Credentials > Sandbox). PAYPAL_ENV must be "sandbox".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# USD per hour for Dogwood meters paid with PayPal; fixed demo rate for fixed-price codes.
DOGWOOD_RATE_USD=2.50
DEMO_USD_PER_SOL=100
