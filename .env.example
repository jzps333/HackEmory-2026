# Copy to .env and fill in. Never commit .env.

# --- Jev (runs through OpenRouter: use your OpenRouter key) ---
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.14
# At or above this malicious score -> block. Between SECOND_LOOK and BLOCK -> Gemini takes a second look.
BLOCK_SCORE=0.8
SECOND_LOOK_SCORE=0.5

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Sandbox server (separate Vultr VM, no keys on it) ---
# Empty = /scan returns mock data so other parts can build now.
SANDBOX_URL=
SANDBOX_TOKEN=

# --- Chert (FaceTime + iMessage) ---
CHERT_API_KEY=
CHERT_WEBHOOK_SECRET=
# LiveKit values go in chert/<agent>/.env.local (written by `lk app env -w -d .env.local`)

# --- Typesense ---
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# --- Tiger Data (Postgres connection string from the downloaded .env) ---
TIGER_DATABASE_URL=

# --- Solana (devnet only) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=

# --- Chert agent extras (chert/agent_integration.py, chert/imessage.py) ---
SCANSAFE_API_URL=http://localhost:8000
CHERT_PROJECT_ID=
CHERT_LINE_ID=
SCANSAFE_DEMO_PHONE=
AGENT_NAME=scansafe-agent
